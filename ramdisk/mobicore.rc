on post-fs
    setprop sys.mobicoredaemon.enable stopped

on post-fs
    export MC_AUTH_TOKEN_PATH /efs
    mkdir /efs/TEE  0770 radio system
    restorecon_recursive /efs/TEE
    chmod 0660 /dev/t-base-tui
    chown system system /dev/t-base-tui

on post-fs-data
    mkdir /data/vendor/mcRegistry 0775 system system
    start mobicore

on property:sys.mobicoredaemon.enable=true
    write /proc/iccc_ready 1

# MobiCore startup
service mobicore /vendor/bin/mcDriverDaemon -p /data/vendor/mcRegistry -p /vendor/app/mcRegistry -r /vendor/app/mcRegistry/FFFFFFFF000000000000000000000001.drbin -r /vendor/app/mcRegistry/ffffffffd0000000000000000000000a.tlbin -r /vendor/app/mcRegistry/ffffffffd00000000000000000000016.tlbin -r /vendor/app/mcRegistry/ffffffffd0000000000000000000001c.tlbin -r /vendor/app/mcRegistry/ffffffffd00000000000000000000045.drbin
    class core
    user system
    group system
    disabled
