#
# IMPORTANT: Do not create world writable files or directories.
# This is a common source of Android security bugs.
#

# service can not be overwritten except SPRINT
# Thus, rilcarrier is imported before common rc, like init.rilchip.rc

on early-init
    symlink /mnt/efs /mnt/vendor/efs
    symlink /mnt/vendor/efs/FactoryApp/serial_no /mnt/vendor/ril_serial
    # Keep the RIL's final path component on EFS for lchown().
    symlink /mnt/vendor/efs/imei /mnt/imei

on post-fs-data
    mkdir /data/vendor/secradio 0770 radio radio

on early-init && property:ro.boot.product.vendor.sku=kor
    setprop ro.multisim.simslotcount 1
    setprop ro.vendor.multisim.simslotcount 1

# secril_config loads the factory slot count from EFS.
on property:ro.multisim.simslotcount=2
    enable ril-daemon1

# Apply the factory mode after loading persisted settings.
on property:ro.persistent_properties.ready=true && property:ro.multisim.simslotcount=1
    setprop persist.radio.multisim.config ss

on property:ro.persistent_properties.ready=true && property:ro.multisim.simslotcount=2
    setprop persist.radio.multisim.config dsds

on property:vts.native_server.on=*
    setprop vendor.vts.native_server.on ${vts.native_server.on}

service secril_config /vendor/bin/secril_config_svc
    user radio
    group radio
    oneshot
    disabled

on post-fs-data
    exec_start secril_config
