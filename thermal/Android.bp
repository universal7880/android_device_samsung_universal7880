cc_binary {
    name: "android.hardware.thermal-service.universal7880",
    vendor: true,
    cpp_std: "c++17",
    relative_install_path: "hw",
    init_rc: ["thermal.rc"],
    vintf_fragments: ["thermal.xml"],
    srcs: ["Thermal.cpp", "service.cpp"],
    shared_libs: [
        "android.hardware.thermal-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
