cc_library_shared {
    name: "libcamera_compat",
    vendor: true,
    compile_multilib: "both",

    srcs: [
        "CameraMetadata.cpp",
        "CameraParameters.cpp",
        "VendorTagDescriptor.cpp",
    ],

    local_include_dirs: ["include"],
    include_dirs: ["system/media/private/camera/include"],
    shared_libs: [
        "libbinder",
        "libcamera_metadata",
        "liblog",
        "libutils",
    ],
}
