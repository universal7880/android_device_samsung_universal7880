cc_binary {
    name: "vendor.lineage.hardware.fmradio-service.si47xx",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    static_libs: ["libfm-si47xx"],
    shared_libs: ["libbase", "libbinder_ndk", "libcutils", "liblog", "vendor.lineage.hardware.fmradio-V2-ndk"],
    init_rc: ["fmradio.rc"],
    vintf_fragments: ["fmradio.xml"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
