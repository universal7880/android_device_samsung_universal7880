filegroup {
    name: "libfmjni-universal7880-srcs",
    srcs: [
        "libfm_jni.cpp",
        "FmRadioClient.cpp",
    ],
}

cc_library_shared {
    name: "libfmjni.vendor",
    stem: "libfmjni",
    vendor: true,
    srcs: [":libfmjni-universal7880-srcs"],
    cflags: ["-DFM_RADIO_VENDOR_AUDIO"],
    header_libs: ["jni_headers"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.hardware.fmradio-V2-ndk",
    ],
}
