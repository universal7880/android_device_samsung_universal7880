# Change ownership of modem configuration files.
allow rild self:capability { chown };

# Create and replace the named NV records. Common policy covers their contents.
allow rild bin_nv_data_efs_file:file { create rename };

# Update the named operator and SIM selection records.
allow rild ril_imei_config_efs_file:file { getattr open read write };

# Read and update /mnt/efs/factory.prop.
allow rild factoryprop_efs_file:file { open read write };

# Read the command lines of the media processes queried by the modem library.
allow rild { audioserver mediaserver }:dir { getattr search };
allow rild { audioserver mediaserver }:file { getattr open read };

# Resolve the modem block device and read Samsung PARAM settings.
allow rild block_device:dir r_dir_perms;
allow rild samsung_param_block_device:blk_file r_file_perms;

# Configure the modem packet-data wake timeout.
allow rild sysfs_multipdp:file rw_file_perms;

# Traverse the legacy SDET PLMN lookup path used by the modem library.
allow rild { mnt_user_file storage_file }:dir search;
allow rild { mnt_user_file storage_file }:lnk_file { getattr read };

# Call the vendor radio HAL over Binder.
allow rild hal_radio_default:binder call;

# Follow the vendor EFS entry point and the legacy IMEI alias.
allow rild { vendor_efs_link ril_imei_link }:lnk_file { getattr read };

# Follow the dedicated symlink to the factory serial number.
allow rild ril_serial_link:lnk_file { getattr read };
allow rild factory_serial_efs_file:file r_file_perms;

# Read and update the modem configuration cached in EFS.
allow rild ril_telephony_efs_file:file { getattr open read setattr write };
