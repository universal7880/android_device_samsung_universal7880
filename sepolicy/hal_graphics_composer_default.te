# Receive kernel uevents for display device changes.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { read create getattr setopt bind };

# Use vendor Binder and Samsung secure memory for composition.
allow hal_graphics_composer_default {
    vndbinder_device
    secmem_device
}:chr_file rw_file_perms;

# Read DECON vsync and panel self-refresh information.
allow hal_graphics_composer_default sysfs_graphics:file r_file_perms;
allow hal_graphics_composer_default sysfs_graphics:dir search;

# ION creates a per-client debugfs entry when the composer opens /dev/ion.
allow hal_graphics_composer_default debugfs_ion:dir search;
