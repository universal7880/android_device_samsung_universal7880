# The passthrough memtrack HAL reads Mali and ION accounting in system_server.
allow system_server debugfs_mali:dir r_dir_perms;
allow system_server debugfs_mali:file r_file_perms;
allow system_server debugfs_ion:dir { getattr search };
allow system_server debugfs_ion:file r_file_perms;

# Apply the display brightness selected by the framework.
allow system_server sysfs_brightness:file { getattr open read write };

# Read the panel's maximum brightness for scaling.
allow system_server sysfs_max_brightness:file { getattr open read };

# BatteryStats reads the legacy kernel wakeup source counters.
allow system_server debugfs_wakeup_sources:file { getattr open read };
