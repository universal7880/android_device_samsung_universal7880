# Universal7880 CP boot daemon permissions

net_domain(cbd)
wakelock_use(cbd)

allow cbd self:capability { setuid setgid };

allow cbd cgroup:dir create_dir_perms;

# /dev/mbin0
allow cbd emmcblk_device:blk_file r_file_perms;
# /dev/block
allow cbd block_device:dir r_dir_perms;

# /dev/mipi-lli/lli_control
allow cbd sysfs_mipi:file rw_file_perms;

allow cbd factoryprop_efs_file:file { open read };

# /mnt/efs/nv_data.bin
allow cbd bin_nv_data_efs_file:file rw_file_perms;

# /sys/bus/usb/devices/1-2/idVendor
allow cbd sysfs:file r_file_perms;

# Follow the Samsung vendor EFS alias.
allow cbd efs_file:lnk_file r_file_perms;
