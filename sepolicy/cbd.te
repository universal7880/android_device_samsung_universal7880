# Universal7880 CP boot daemon permissions

# Apply the platform network policy to the CP boot daemon.
net_domain(cbd)

# The modem boot daemon uses /sys/power/wake_lock directly.
allow cbd self:global_capability2_class_set block_suspend;

# Change group when starting the modem boot process.
allow cbd self:capability setgid;

# Read the modem NV, carrier and CP debug partitions.
allow cbd { samsung_cp_nv_block_device samsung_cp_debug_block_device }:blk_file r_file_perms;

# Find the block device nodes referenced by the modem boot binary.
allow cbd block_device:dir r_dir_perms;

# Read Samsung factory modem configuration.
allow cbd factoryprop_efs_file:file { open read };

# Read and update the modem NV record.
allow cbd bin_nv_data_efs_file:file rw_file_perms;

# Follow the Samsung vendor EFS alias.
allow cbd vendor_efs_link:lnk_file r_file_perms;

# Read the hardware revision passed in the bootloader device tree.
allow cbd sysfs_modem_board_revision:file { getattr open read };
