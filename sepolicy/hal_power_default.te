# Traverse the physical input devices to reach the shared touchscreen controls.
allow hal_power_default sysfs_touch_input_dir:dir search;

# Traverse DECON to read the display state before gating input.
allow hal_power_default sysfs_graphics:dir search;

# Read the panel level before gating input.
allow hal_power_default sysfs_brightness:file { getattr open read };

# Tell the thermal HAL whether the device is interactive.
set_prop(hal_power_default, vendor_thermal_state_prop)
