# Mount debugfs on /sys/kernel/debug.
allow init debugfs:dir mounton;

# Mount EFS on /mnt/efs.
allow init efs_file:dir  mounton;

# Set ownership or mode on block-device symlinks.
allow init block_device:lnk_file { setattr };

# Create and maintain symlinks on init-managed tmpfs.
allow init tmpfs:lnk_file create_file_perms;

# Follow and set attributes on mDNIe symlinks.
allow init sysfs_mdnie:lnk_file { read setattr };

# Label camera sysfs attributes and set their ownership and mode.
allow init { sysfs_camera sysfs_camera_control }:file { relabelto setattr };

# Apply init ownership and mode to Bluetooth, display, modem data and GNSS attributes.
allow init sysfs_bluetooth_writable:file setattr;
allow init { sysfs_mdnie sysfs_mdnie_scenario }:file setattr;
allow init sysfs_multipdp:file setattr;
allow init sysfs_gps:file setattr;
allow init sysfs_brightness:file setattr;

# Set DAC ownership and mode on the touchscreen and touchkey enable controls.
allow init sysfs_touchscreen_writable:file setattr;

# Open panel attributes and apply the ownership and mode declared by init.
allow init sysfs_lcd:file { setattr open };

# Configure the modem SIM-detection attribute.
allow init sysfs_modem:file { setattr write };

# Set ownership and mode on battery attributes.
allow init sysfs_batteryinfo:file setattr;

# Read the modem SIM-detection attribute.
allow init sysfs_modem:file r_file_perms;

# Connect init to the RIL property socket.
unix_socket_connect(init, property, rild)

# Label the physical backing device for retrofit dynamic partitions.
allow init super_block_device:blk_file relabelto;
