# Allow kernel workers to change ownership and create device nodes.
allow kernel self:capability { chown mknod };

# Read the Samsung PARAM configuration partition.
allow kernel samsung_param_block_device:blk_file r_file_perms;

# Create and remove USB bus directories and character nodes during hotplug.
allow kernel device:dir { create write remove_name rmdir add_name };
allow kernel device:chr_file { create setattr getattr unlink };

# Traverse EFS to access the hardware calibration records used by kernel drivers.
allow kernel { app_efs_file battery_efs_file efs_file }:dir search;
allow kernel { factory_battery_efs_file factory_sensor_cal_efs_file sensor_efs_file sensor_factoryapp_efs_file }:file rw_file_perms;
allow kernel baro_delta_factoryapp_efs_file:file r_file_perms;

# The WLAN driver can initialize the persistent MAC file in a kernel worker.
allow kernel wifi_efs_file:dir { search write add_name };
allow kernel wifi_mac_efs_file:file { create getattr open read write };
type_transition kernel wifi_efs_file:file wifi_mac_efs_file ".mac.info";

# Read panel attributes used by kernel drivers, including the touchkey window type.
allow kernel sysfs_lcd:file { open read };

# Traverse /dev/block to reach named partitions.
allow kernel block_device:dir search;
