# The SSP driver can save calibration with the credentials of the sensor caller.
allow hal_sensors_default { factory_sensor_cal_efs_file sensor_factoryapp_efs_file }:file { create rw_file_perms };
type_transition hal_sensors_default app_efs_file:file factory_sensor_cal_efs_file "calibration_data";
type_transition hal_sensors_default app_efs_file:file factory_sensor_cal_efs_file "gyro_cal_data";
type_transition hal_sensors_default app_efs_file:file sensor_factoryapp_efs_file "prox_cal";

# Enable the SSP IIO buffers and set their queue length.
allow hal_sensors_default sysfs_iio_writable:file { open read getattr write };

# Follow the IIO class links to the SSP devices.
allow hal_sensors_default sysfs_iio:lnk_file read;
