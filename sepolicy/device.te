# Samsung PARAM configuration partition.
type samsung_param_block_device, dev_type;

# Partition labels for the Samsung modem boot daemon.
type samsung_cp_nv_block_device, dev_type;
type samsung_cp_debug_block_device, dev_type;

# Radio kill switch character device.
type rfkill_device, dev_type;

# Samsung secure memory device for protected media buffers.
type secmem_device, dev_type;

# I2C controller exposed to the TFA98xx speaker amplifier HAL.
type amplifier_device, dev_type;

# GNSS IPC character device shared with the modem.
type gps_device, dev_type;

# Silicon Labs FM tuner
type fm_device, dev_type;
