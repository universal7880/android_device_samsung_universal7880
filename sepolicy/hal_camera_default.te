# Read camera hardware information and use the separate writable controls.
allow hal_camera_default sysfs_camera:dir search;
allow hal_camera_default sysfs_camera:file r_file_perms;
allow hal_camera_default sysfs_camera_control:file rw_file_perms;

# Find the graphics mapper used to handle camera buffers.
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;

# Use sync fence descriptors passed by the graphics composer.
allow hal_camera_default hal_graphics_composer_default:fd use;

# Use the vendor Binder context for Samsung camera components.
vndbinder_use(hal_camera_default)

# Framework SensorManager and its sensor event callbacks.
binder_call(hal_camera_default, system_server)
allow system_server hal_camera_default:binder call;

# FIMC-IS stores calibration and hardware error counts in the caller context.
allow hal_camera_default camera_vendor_data_file:dir rw_dir_perms;
allow hal_camera_default camera_vendor_data_file:file create_file_perms;

# Read the vendor sizes of both camera metadata queues.
get_prop(hal_camera_default, vendor_camera_request_fmq_prop)
get_prop(hal_camera_default, vendor_camera_result_fmq_prop)
