# Call wificond to request Wi-Fi controller operations.
allow system_app wificond:binder call;
# Read the kernel page allocator statistics.
allow system_app proc_pagetypeinfo:file { read open getattr };

# Allow system apps to use the FM tuner service.
hal_client_domain(system_app, hal_fmradio)

# AdvancedDisplay applies its selected screen scenario at boot and on change.
allow system_app sysfs_mdnie_scenario:file { getattr open write };
