# Prepare and relabel the MobiCore vendor data directory during boot.
allow vendor_init mobicore_vendor_data_file:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };

# Set the SIM slot count consumed by Samsung's vendor binaries.
set_prop(vendor_init, vendor_radio_prop)

# Apply init ownership and mode changes to block-device symlinks.
allow vendor_init block_device:lnk_file setattr;

# Check the trace marker when applying its boot-time label.
allow vendor_init debugfs_trace_marker:file getattr;

# Configure VM reclaim for ZRAM using the specific sysctl labels.
allow vendor_init { proc_min_free_order_shift proc_universal7880_swappiness }:file write;

# Initialize device-specific HAL configuration properties.
set_prop(vendor_init, vendor_fingerprint_config_prop)
set_prop(vendor_init, vendor_vibrator_config_prop)

# Create the EFS compatibility symlinks during early init.
allow vendor_init { vendor_efs_link ril_imei_link ril_serial_link }:lnk_file create;

# Assign the touchkey calibration files to the kernel worker.
allow vendor_init factory_touchkey_efs_file:file setattr;

# Mirror the platform VTS status for Samsung RIL.
get_prop(vendor_init, vts_status_prop)
set_prop(vendor_init, vendor_ril_vts_status_prop)
