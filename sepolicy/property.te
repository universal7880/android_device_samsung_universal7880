# Debug level read by the Samsung NFC HAL.
vendor_internal_prop(vendor_nfc_debug_prop)

# Device-specific fingerprint type and enrollment limit.
vendor_internal_prop(vendor_fingerprint_config_prop)

# Framework interactivity shared by the Power and Thermal HALs.
vendor_internal_prop(vendor_thermal_state_prop)

# Vibrator effect durations configured by the device.
vendor_internal_prop(vendor_vibrator_config_prop)
