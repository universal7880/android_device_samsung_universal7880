# Allow the platform system app to call the fingerprint HAL.
binder_call(system_app, hal_fingerprint_default)

# Use secure memory for fingerprint operations.
allow hal_fingerprint_default secmem_device:chr_file { open read write ioctl };

# Connect to the TEE daemon over its Unix socket.
allow hal_fingerprint_default tee:unix_stream_socket connectto;

# Read device-specific fingerprint settings.
get_prop(hal_fingerprint_default, vendor_fingerprint_config_prop)
