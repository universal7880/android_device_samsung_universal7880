# Read and configure the Unix stream socket owned by system_server.
allow gpsd system_server:unix_stream_socket { read write setopt };

# Open raw sockets for the legacy GNSS daemon.
allow gpsd self:capability net_raw;

# Label GNSS sockets created in the vendor GPS data directory.
type_transition gpsd gps_vendor_data_file:sock_file gps_socket;
allow gpsd gps_socket:sock_file create_file_perms;

# Read the legacy Samsung GPS sysfs controls.
allow gpsd sysfs_gps:file { open read getattr };

# Open the GNSS transport.
allow gpsd gps_device:chr_file { getattr setattr rw_file_perms };

# Hold a kernel wake lock while GNSS work is pending.
allow gpsd sysfs_wake_lock:file rw_file_perms;

# Look up the legacy framework sensor service through servicemanager.
allow gpsd servicemanager:binder call;
allow gpsd sensorservice_service:service_manager { find };

# Find the AIDL SystemSuspend service used by the GNSS daemon.
allow gpsd hal_system_suspend_service:service_manager find;

# Read the modem boot interface referenced by the GNSS daemon.
allow gpsd vendor_radio_device:chr_file { getattr open read };

# Check whether the system boot animation has finished.
get_prop(gpsd, bootanim_system_prop)
