# Device nodes and sockets

# Mali GPU and secure memory used by graphics and DRM.
/dev/mali[0-9]*              u:object_r:gpu_device:s0
/dev/s5p-smem                u:object_r:secmem_device:s0

# V4L2 subdevices, hardware scaler and camera media nodes.
/dev/v4l-subdev[0-9]*        u:object_r:video_device:s0
/dev/m2m1shot_scaler[0-9]*   u:object_r:video_device:s0
/dev/media[0-3]*             u:object_r:camera_device:s0

# NFC controller device nodes.
/dev/sec-nfc                 u:object_r:nfc_device:s0

# Bluetooth UART and radio power switch.
/dev/ttySAC0                 u:object_r:bt_device:s0
/dev/rfkill                  u:object_r:rfkill_device:s0

# TFA98xx speaker amplifier I2C device.
/dev/i2c-20                  u:object_r:amplifier_device:s0

# GNSS shares memory with the modem and exposes a dedicated IPC node.
/dev/gnss_ipc                u:object_r:gps_device:s0

# The secondary UART is distinct from the Bluetooth transport on ttySAC0.
/dev/ttySAC2                 -c u:object_r:serial_device:s0

# Modem IPC and boot control device nodes.
# Additional SS325AP interfaces absent from the Samsung common labels.
/dev/umts_csd                -c u:object_r:vendor_radio_device:s0
/dev/umts_ramdump0           -c u:object_r:vendor_radio_device:s0
/dev/umts_ciq0               -c u:object_r:vendor_radio_device:s0

# FM tuner device and the FM audio socket.
/dev/radio0                 u:object_r:fm_device:s0
/dev/socket/universal7880_fm_audio    u:object_r:fm_audio_socket:s0

# Second SIM RIL sockets.
/dev/socket/rild2                           u:object_r:rild_socket:s0
/dev/socket/rild-debug2                     u:object_r:rild_debug_socket:s0

# SIM Access Profile socket opened by init for the modem daemon.
/dev/socket/sap_uim_socket1                  -s u:object_r:ril_sap_socket:s0

# Secondary watchdog exposed by the Samsung kernel.
/dev/watchdog1               u:object_r:watchdog_device:s0

# Legacy schedtune cgroup used by adbroot and storaged.
/dev/stune(/.*)?		u:object_r:cgroup:s0

# eMMC partitions

# PARAM configuration accessed by Samsung RIL and kernel drivers.
/dev/block/mmcblk0p9 -b u:object_r:samsung_param_block_device:s0

# Optional modem NV and carrier partitions named by the Samsung CP boot daemon.
/dev/block/mmcblk0p7 -b u:object_r:samsung_cp_nv_block_device:s0
/dev/block/mmcblk0p8 -b u:object_r:samsung_cp_nv_block_device:s0

# CP_DEBUG partition used by the Samsung CP boot daemon.
/dev/block/mmcblk0p22 -b u:object_r:samsung_cp_debug_block_device:s0

# STEADY partition used for Samsung device state.
/dev/block/mmcblk0p17 -b u:object_r:steady_block_device:s0

# Boot and recovery images.
/dev/block/mmcblk0p10        u:object_r:boot_block_device:s0
/dev/block/mmcblk0p11        u:object_r:recovery_block_device:s0

# Samsung OTA partition used for the Android bootloader message.
/dev/block/mmcblk0p12        u:object_r:misc_block_device:s0

# Modem firmware and factory reset protection.
/dev/block/mmcblk0p13        u:object_r:radio_block_device:s0
/dev/block/mmcblk0p16        u:object_r:frp_block_device:s0

# Swap device used by Android's mkswap and swapon paths.
/dev/block/zram0             -b u:object_r:swap_block_device:s0

# Physical device for retrofit dynamic partitions, cache and userdata.
/dev/block/mmcblk0p19        u:object_r:super_block_device:s0
/dev/block/mmcblk0p20        u:object_r:cache_block_device:s0
/dev/block/mmcblk0p25        u:object_r:userdata_block_device:s0

# EFS mount and data

# Mount point for the EFS filesystem.
/mnt/efs                                    -d u:object_r:efs_file:s0

# Legacy root alias and the vendor entry point to the EFS mount.
/efs                                        -l u:object_r:rootfs:s0
/mnt/vendor/efs                             -l u:object_r:vendor_efs_link:s0

# Samsung RIL aliases for IMEI files and the factory serial number.
/mnt/imei                                   -l u:object_r:ril_imei_link:s0
/mnt/vendor/ril_serial                      -l u:object_r:ril_serial_link:s0

# Fuel-gauge calibration maintained on EFS.
/mnt/efs/Battery                            -d u:object_r:battery_efs_file:s0
/mnt/efs/Battery/(batt_capacity_max|fg_full_voltage) -- u:object_r:factory_battery_efs_file:s0

# Adaptive fast charging data.
/mnt/efs/afc(/.*)?                          u:object_r:sec_efs_file:s0

# Bluetooth, NFC and Wi-Fi factory data.
/mnt/efs/bluetooth(/.*)?                    u:object_r:bluetooth_efs_file:s0
/mnt/efs/nfc(/.*)?                          u:object_r:nfc_efs_file:s0
/mnt/efs/wifi(/.*)?                         u:object_r:wifi_efs_file:s0

# Device provisioning, firmware and trusted execution data.
/mnt/efs/DAK(/.*)?                          u:object_r:prov_efs_file:s0
/mnt/efs/pfw_data(/.*)?                     u:object_r:pfw_efs_file:s0
/mnt/efs/prov(/.*)?                         u:object_r:prov_efs_file:s0
/mnt/efs/prov_data(/.*)?                    u:object_r:prov_efs_file:s0

/mnt/efs/tee(/.*)?                          u:object_r:tee_efs_file:s0

# Factory application data and legacy root directory.
/mnt/efs/root(/.*)?                         u:object_r:app_efs_file:s0
/mnt/efs/FactoryApp                         -d u:object_r:app_efs_file:s0

# Factory calibration, battery history and the serial number used by the modem.
/mnt/efs/FactoryApp/(accel_calibration_data|calibration_data|gyro_cal_data|hw_offset|prox_settings) -- u:object_r:factory_sensor_cal_efs_file:s0
/mnt/efs/FactoryApp/(asoc|batt_after_manufactured|batt_cable_count|batt_discharge_level|batt_temp_charge|max_current|max_temp) -- u:object_r:factory_battery_efs_file:s0
/mnt/efs/FactoryApp/cisd_(cable_data|data|data_a5y17lte|data_a7y17lte|fullcaprep_max|power_data|tx_data|wc_data) -- u:object_r:factory_battery_efs_file:s0
/mnt/efs/FactoryApp/serial_no                -- u:object_r:factory_serial_efs_file:s0


/mnt/efs/FactoryApp/baro_delta              u:object_r:baro_delta_factoryapp_efs_file:s0
/mnt/efs/FactoryApp/factorymode             u:object_r:factorymode_factoryapp_efs_file:s0
/mnt/efs/FactoryApp/prox_cal                u:object_r:sensor_factoryapp_efs_file:s0
/mnt/efs/gyro_cal_data                      u:object_r:sensor_efs_file:s0

# IMEI directory and factory product code.
/mnt/efs/imei                               -d u:object_r:imei_efs_file:s0
/mnt/efs/imei/selective                     -d u:object_r:imei_efs_file:s0
/mnt/efs/imei/prodcode\.dat                 -- u:object_r:imei_efs_file:s0

# Operator and SIM selection data referenced by the single- and dual-SIM RIL.
/mnt/efs/imei/(mps_code|omcnw_code2?|replace_code)\.dat -- u:object_r:ril_imei_config_efs_file:s0
/mnt/efs/imei/selective                     -- u:object_r:ril_imei_config_efs_file:s0

# Modem factory records, NV backups and telephony configuration.
/mnt/efs/FactoryApp/fdata                   u:object_r:radio_factoryapp_efs_file:s0
/mnt/efs/FactoryApp/hist_nv                 u:object_r:radio_factoryapp_efs_file:s0
/mnt/efs/FactoryApp/test_nv                 u:object_r:radio_factoryapp_efs_file:s0
/mnt/efs/nv_data\.bin(\.md5)?              -- u:object_r:bin_nv_data_efs_file:s0
/mnt/efs/nv\.log                           -- u:object_r:bin_nv_data_efs_file:s0
/mnt/efs/\.nv_core\.bak(\.md5)?           -- u:object_r:bin_nv_data_efs_file:s0
/mnt/efs/factory\.prop                      u:object_r:factoryprop_efs_file:s0
/mnt/efs/telephony\.prop                   -- u:object_r:ril_telephony_efs_file:s0

# Legacy DRM provisioning records.
/mnt/efs/cpk(/.*)?                          u:object_r:cpk_efs_file:s0
/mnt/efs/drm(/.*)?                          u:object_r:drm_efs_file:s0
/mnt/efs/h2k\.dat                           u:object_r:cpk_efs_file:s0

/mnt/efs/wv\.keys                              u:object_r:cpk_efs_file:s0

# Gatekeeper context directory and per-user records.
/mnt/efs/TEE                                u:object_r:gatekeeper_efs_file:s0
/mnt/efs/TEE/gk_context(_sub)?_[0-9a-f]+    u:object_r:gatekeeper_efs_file:s0

# Same-process HAL libraries

# Legacy memtrack runs inside system_server and loads these vendor libraries.
/(vendor|system/vendor)/lib(64)?/hw/android\.hardware\.memtrack@1\.0-impl\.so -- u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/memtrack\.exynos5\.so -- u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/android\.hardware\.memtrack@1\.0\.so -- u:object_r:same_process_hal_file:s0

# Persistent service data

# Legacy and vendor NFC state.
/data/nfc(/.*)?              u:object_r:nfc_data_file:s0
/data/vendor/nfc(/.*)?       u:object_r:nfc_vendor_data_file:s0

# Vendor camera, Bluetooth and Widevine state.
/data/vendor/camera(/.*)?    u:object_r:camera_vendor_data_file:s0
/data/vendor/bluetooth(/.*)?    u:object_r:vendor_bluetooth_data_file:s0
/data/vendor/mediadrm(/.*)?       u:object_r:mediadrm_data_file:s0

# Sysfs attributes

# Only the Bluetooth driver's rfkill attributes. The index is assigned at runtime.
/sys/devices/bluetooth/rfkill/rfkill[0-9]+/(state|type) -- u:object_r:sysfs_bluetooth_writable:s0

# Samsung camera information and controls.
/sys/devices/virtual/camera(/(rear|front|flash|ois|secure))? -d u:object_r:sysfs_camera:s0
/sys/devices/virtual/camera/rear/(fw_update|rear_(afcal|calcheck|camfw|camfw_full|caminfo|camtype|checkfw_factory|checkfw_user|moduleid|sensorid|sensorid_exif)|rear[23]_sensorid_exif) -- u:object_r:sysfs_camera:s0
/sys/devices/virtual/camera/front/front_(camfw|camfw_full|caminfo|camtype|checkfw_factory|moduleid|sensorid|sensorid_exif) -- u:object_r:sysfs_camera:s0
/sys/devices/virtual/camera/ois/ois_(diff|exif|rawdata|selftest) -- u:object_r:sysfs_camera:s0
/sys/devices/virtual/camera/secure/secure_sensorid -- u:object_r:sysfs_camera:s0

# Writable camera controls and torch attributes used by the vendor HAL.
/sys/devices/virtual/camera/rear/rear_(hwparam|sensor_standby) -- u:object_r:sysfs_camera_control:s0
/sys/devices/virtual/camera/front/front_hwparam -- u:object_r:sysfs_camera_control:s0
/sys/devices/virtual/camera/flash/(rear_flash|rear_torch_flash[23]?|front_torch_flash) -- u:object_r:sysfs_camera_control:s0
/sys/devices/virtual/camera/ois/ois_power -- u:object_r:sysfs_camera_control:s0

# Battery and charger information.
/sys/devices/battery/power_supply(/.*)                                     u:object_r:sysfs_batteryinfo:s0
/sys/devices/13870000.i2c/i2c-7/7-003d/s2mu004-charger/power_supply(/.*)   u:object_r:sysfs_batteryinfo:s0
/sys/devices/13830000.i2c/i2c-10/10-003b/power_supply(/.*)                 u:object_r:sysfs_batteryinfo:s0

# Preserve the dedicated temperature label during power_supply restorecon.
/sys/devices/battery/power_supply/battery/temp -- u:object_r:sysfs_universal7880_battery_temp:s0

# Preserve the dedicated charging limit label during restorecon.
/sys/devices/battery/power_supply/battery/thermal_siop_level -- u:object_r:sysfs_battery_thermal:s0

# Power and Touch HAL input controls. Input indices depend on probe order.
/sys/devices/i2c@20/i2c-6/6-0020/input/input[0-9]+/enabled -- u:object_r:sysfs_touchscreen_writable:s0
/sys/devices/13890000\.i2c/i2c-9/9-00(20|48)/input/input[0-9]+/enabled -- u:object_r:sysfs_touchscreen_writable:s0

# Physical touchscreen and touchkey directories traversed to reach enabled.
/sys/devices/i2c@20/i2c-6/6-0020/input/input[0-9]+ -d u:object_r:sysfs_touch_input_dir:s0
/sys/devices/13890000\.i2c/i2c-9/9-00(20|48)/input/input[0-9]+ -d u:object_r:sysfs_touch_input_dir:s0

# Touchscreen and touchkey input links followed by the Power HAL.
/sys/devices/virtual/sec/(tsp|sec_touchkey)/input -l u:object_r:sysfs_sec_touchscreen:s0

# SSP sensor names and IIO buffer directories.
/sys/devices/13930000\.spi/spi_master/spi2/spi2\.0/iio:device[0-9]+(/buffer)? -d u:object_r:sysfs_iio:s0
/sys/devices/13930000\.spi/spi_master/spi2/spi2\.0/iio:device[0-9]+/name -- u:object_r:sysfs_iio:s0

# Read the ADC identifier when looking for SSP IIO devices.
/sys/devices/10650000\.adc/iio:device[0-9]+/name -- u:object_r:sysfs_iio:s0

# IIO buffer attributes written by the Sensors HAL.
/sys/devices/13930000\.spi/spi_master/spi2/spi2\.0/iio:device[0-9]+/buffer/(enable|length) -- u:object_r:sysfs_iio_writable:s0

# Removable SD card paths traversed by vold and fsck.
/sys/devices/13560000\.dwmmc2 -d u:object_r:sysfs_mmc:s0
/sys/devices/13560000\.dwmmc2/mmc_host(/mmc[0-9]+)? -d u:object_r:sysfs_mmc:s0
/sys/devices/13560000\.dwmmc2/mmc_host/mmc[0-9]+/mmc[0-9]+:[0-9a-f]{4} -d u:object_r:sysfs_mmc:s0
/sys/devices/13560000\.dwmmc2/mmc_host/mmc[0-9]+/mmc[0-9]+:[0-9a-f]{4}/block(/mmcblk[0-9]+(/mmcblk[0-9]+p[0-9]+)?)? -d u:object_r:sysfs_mmc:s0

# Block and partition uevents replayed by vold during coldboot.
/sys/devices/13560000\.dwmmc2/mmc_host/mmc[0-9]+/mmc[0-9]+:[0-9a-f]{4}/block/mmcblk[0-9]+(/mmcblk[0-9]+p[0-9]+)?/uevent -- u:object_r:sysfs_mmc:s0

