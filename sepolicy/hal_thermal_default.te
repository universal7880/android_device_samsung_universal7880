binder_use(hal_thermal_default)

# The common policy grants read access to thermal files. Add sysfs traversal
# and symlink access for the thermal class and zone-to-cooling-device links.
allow hal_thermal_default sysfs:dir search;
allow hal_thermal_default sysfs:lnk_file read;
allow hal_thermal_default sysfs_virtual:dir search;
allow hal_thermal_default sysfs_thermal:lnk_file read;

# Read the AP thermistor; CPU limits use per-open PM QoS requests.
r_dir_file(hal_thermal_default, sysfs_ap_thermal)
allow hal_thermal_default pm_qos_device:chr_file { open write getattr };
get_prop(hal_thermal_default, vendor_universal7880_variant_prop)

allow hal_thermal_default sysfs_gpu_thermal:file rw_file_perms;
