// SPDX-License-Identifier: Apache-2.0

cc_binary {
    name: "android.hardware.drm-service.widevine.universal7880",
    stem: "android.hardware.drm-service.widevine",
    vendor: true,
    compile_multilib: "32",
    relative_install_path: "hw",
    srcs: [
        "Crypto.cpp",
        "Drm.cpp",
        "Efs.cpp",
        "Service.cpp",
    ],
    ldflags: [
        "-Wl,--export-dynamic-symbol=access",
        "-Wl,--export-dynamic-symbol=fopen",
        "-Wl,--export-dynamic-symbol=open",
        "-Wl,--export-dynamic-symbol=__open_2",
        "-Wl,--export-dynamic-symbol=opendir",
        "-Wl,--export-dynamic-symbol=stat",
    ],
    init_rc: ["widevine.rc"],
    vintf_fragments: ["widevine.xml"],
    header_libs: ["media_plugin_headers"],
    shared_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.drm-V1-ndk",
        "libbinder_ndk",
        "libcutils",
        "libdl",
        "liblog",
        "libstagefright_foundation",
        "libutils",
    ],
    static_libs: ["libaidlcommonsupport"],
}
