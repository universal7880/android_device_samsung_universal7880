package {
    default_applicable_licenses: ["universal7880_bluetooth_service_license"],
}

license {
    name: "universal7880_bluetooth_service_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

cc_binary {
    name: "android.hardware.bluetooth-service.universal7880",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["service.rc"],
    srcs: [
        "service.cpp",
        "ant/Ant.cpp",
        "aidl/BluetoothHci.cpp",
    ],
    local_include_dirs: [
        "address",
        "libbt-vendor/include",
    ],
    shared_libs: [
        "android.hardware.bluetooth-V1-ndk",
        "libbinder_ndk",
        "com.dsi.ant@1.0",
        "libbase",
        "libbt-vendor",
        "libcutils",
        "libdl",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    static_libs: ["libuniversal7880_bluetooth_address"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_test {
    name: "universal7880_ant_transport_test",
    defaults: ["hidl_defaults"],
    vendor: true,
    gtest: false,
    srcs: [
        "ant/Ant.cpp",
        "tests/ant_test.cpp",
    ],
    local_include_dirs: [
        "address",
        "libbt-vendor/include",
    ],
    shared_libs: [
        "com.dsi.ant@1.0",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    test_suites: ["device-tests"],
}

cc_library_static {
    name: "libuniversal7880_bluetooth_address",
    vendor: true,
    srcs: ["address/bluetooth_address.cc"],
    export_include_dirs: ["address"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
    ],
}

cc_test {
    name: "universal7880_bluetooth_aidl_test",
    vendor: true,
    gtest: false,
    srcs: [
        "aidl/BluetoothHci.cpp",
        "tests/bluetooth_test.cpp",
    ],
    local_include_dirs: [
        "address",
        "libbt-vendor/include",
    ],
    shared_libs: [
        "android.hardware.bluetooth-V1-ndk",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    test_suites: ["device-tests"],
}
