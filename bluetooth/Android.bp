package {
    default_applicable_licenses: ["universal7880_bluetooth_service_license"],
}

license {
    name: "universal7880_bluetooth_service_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

cc_binary {
    name: "android.hardware.bluetooth@1.1-service.universal7880",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["service.rc"],
    srcs: [
        "service.cpp",
        "ant/Ant.cpp",
        "hidl/bluetooth_hci.cc",
    ],
    include_dirs: [
        "device/samsung/universal7880-common/bluetooth/libbt-vendor/include",
        "hardware/interfaces/bluetooth/1.0/default",
    ],
    shared_libs: [
        "android.hardware.bluetooth@1.0",
        "android.hardware.bluetooth@1.0-impl",
        "android.hardware.bluetooth@1.1",
        "com.dsi.ant@1.0",
        "libbase",
        "libbt-vendor",
        "libcutils",
        "libdl",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    static_libs: ["android.hardware.bluetooth-hci"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_test {
    name: "universal7880_ant_transport_test",
    defaults: ["hidl_defaults"],
    vendor: true,
    gtest: false,
    srcs: [
        "ant/Ant.cpp",
        "tests/ant_test.cpp",
    ],
    include_dirs: [
        "device/samsung/universal7880-common/bluetooth/libbt-vendor/include",
        "hardware/interfaces/bluetooth/1.0/default",
    ],
    shared_libs: [
        "com.dsi.ant@1.0",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    test_suites: ["device-tests"],
}
