package {
    default_applicable_licenses: ["universal7880_bluetooth_license"],
}

license {
    name: "universal7880_bluetooth_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

cc_library_shared {
    name: "libbt-vendor",
    vendor: true,
    srcs: [
        "src/bt_vendor_exynos.c",
        "src/h4_transport.cpp",
        "src/hci_uart.c",
        "src/hw_rome.c",
    ],
    local_include_dirs: ["include"],
    include_dirs: ["hardware/interfaces/bluetooth/1.0/default"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-fvisibility=hidden",
    ],
}

cc_test {
    name: "universal7880_bluetooth_transport_test",
    vendor: true,
    gtest: false,
    srcs: [
        "src/h4_transport.cpp",
        "tests/h4_transport_test.cpp",
    ],
    local_include_dirs: ["include"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-UNDEBUG",
    ],
    test_suites: ["device-tests"],
}
