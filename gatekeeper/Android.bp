cc_binary {
    name: "android.hardware.gatekeeper-service.universal7880",
    stem: "android.hardware.gatekeeper-service",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    init_rc: ["gatekeeper.rc"],
    srcs: [
        "Trustlet.cpp",
        "service.cpp",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    header_libs: ["libhardware_headers"],
    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/tee/kinibi410/vendor/ClientLib/include",
        "system/gatekeeper/include",
    ],
    shared_libs: [
        "android.hardware.gatekeeper-V1-ndk",
        "//vendor/samsung/universal7880:libMcClient",
        "libbase",
        "libbinder_ndk",
    ],
}
